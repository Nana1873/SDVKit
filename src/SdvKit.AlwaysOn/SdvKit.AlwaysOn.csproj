<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SdvKit.AlwaysOn</AssemblyName>
    <RootNamespace>SdvKit.AlwaysOn</RootNamespace>
    <Description>Minimal game-side background-run guard for an isolated SDVKit lab.</Description>
    <Version>0.6.1</Version>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**</DefaultItemExcludes>
    <SdvGamePath Condition="'$(SdvGamePath)' == '' and '$(SDV_GAME_PATH)' != ''">$(SDV_GAME_PATH)</SdvGamePath>
    <DefineConstants>$(DefineConstants);SDVKIT_GAME_AVAILABLE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SdvKit.Cli\LiveLab\LoadedModsModels.cs" Link="LiveLab\LoadedModsModels.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\ModBuildIdentity.cs" Link="LiveLab\ModBuildIdentity.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\NetworkTwoModels.cs" Link="LiveLab\NetworkTwoModels.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\ProjectModModels.cs" Link="LiveLab\ProjectModModels.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\ReviewAudioModels.cs" Link="LiveLab\ReviewAudioModels.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\ReviewInputModels.cs" Link="LiveLab\ReviewInputModels.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\ReviewDataModels.cs" Link="LiveLab\ReviewDataModels.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\ReviewFixtureModels.cs" Link="LiveLab\ReviewFixtureModels.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\ReviewMapModels.cs" Link="LiveLab\ReviewMapModels.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\ReviewModAssetModels.cs" Link="LiveLab\ReviewModAssetModels.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\ReviewScreenshotModels.cs" Link="LiveLab\ReviewScreenshotModels.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\ReviewTextureModels.cs" Link="LiveLab\ReviewTextureModels.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\ReviewTexturePngValidator.cs" Link="LiveLab\ReviewTexturePngValidator.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\ReviewTransportModels.cs" Link="LiveLab\ReviewTransportModels.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\RuntimeVersionCompatibility.cs" Link="LiveLab\RuntimeVersionCompatibility.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\RuntimeSnapshotModels.cs" Link="LiveLab\RuntimeSnapshotModels.cs" />
    <Compile Include="..\SdvKit.Cli\LiveLab\TestSaveModels.cs" Link="LiveLab\TestSaveModels.cs" />
    <Reference Include="StardewModdingAPI">
      <HintPath>$(SdvGamePath)\StardewModdingAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SdvGamePath)\smapi-internal\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="StardewValley">
      <HintPath>$(SdvGamePath)\Stardew Valley.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="StardewValley.GameData">
      <HintPath>$(SdvGamePath)\StardewValley.GameData.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SMAPI.Toolkit.CoreInterfaces">
      <HintPath>$(SdvGamePath)\smapi-internal\SMAPI.Toolkit.CoreInterfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoGame.Framework">
      <HintPath>$(SdvGamePath)\MonoGame.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="xTile">
      <HintPath>$(SdvGamePath)\xTile.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ValidateSdvGamePath" BeforeTargets="ResolveReferences">
    <Error
      Condition="'$(SdvGamePath)' == ''"
      Text="SdvKit.AlwaysOn requires SdvGamePath (or SDV_GAME_PATH) to point to a local Stardew Valley + SMAPI installation." />
    <Error
      Condition="'$(SdvGamePath)' != '' and !Exists('$(SdvGamePath)\StardewModdingAPI.dll')"
      Text="SdvKit.AlwaysOn requires '$(SdvGamePath)\StardewModdingAPI.dll'." />
    <Error
      Condition="'$(SdvGamePath)' != '' and !Exists('$(SdvGamePath)\smapi-internal\0Harmony.dll')"
      Text="SdvKit.AlwaysOn requires SMAPI's bundled 'smapi-internal\0Harmony.dll'." />
    <Error
      Condition="'$(SdvGamePath)' != '' and !Exists('$(SdvGamePath)\Stardew Valley.dll')"
      Text="SdvKit.AlwaysOn requires '$(SdvGamePath)\Stardew Valley.dll'." />
    <Error
      Condition="'$(SdvGamePath)' != '' and !Exists('$(SdvGamePath)\StardewValley.GameData.dll')"
      Text="SdvKit.AlwaysOn requires '$(SdvGamePath)\StardewValley.GameData.dll' for canonical building and farm-animal data." />
    <Error
      Condition="'$(SdvGamePath)' != '' and !Exists('$(SdvGamePath)\MonoGame.Framework.dll')"
      Text="SdvKit.AlwaysOn requires '$(SdvGamePath)\MonoGame.Framework.dll' for GameRunner lifecycle and focus state." />
    <Error
      Condition="'$(SdvGamePath)' != '' and !Exists('$(SdvGamePath)\xTile.dll')"
      Text="SdvKit.AlwaysOn requires '$(SdvGamePath)\xTile.dll' for the exact in-memory starting-cabin marker." />
    <Error
      Condition="'$(SdvGamePath)' != '' and !Exists('$(SdvGamePath)\smapi-internal\SMAPI.Toolkit.CoreInterfaces.dll')"
      Text="SdvKit.AlwaysOn requires SMAPI's internal semantic-version interface assembly." />
  </Target>
</Project>
