<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>SdvKit.Tests</AssemblyName>
    <RootNamespace>SdvKit.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" ExcludeAssets="all" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SdvKit.Cli\SdvKit.Cli.csproj" />
    <Compile Include="..\..\docs\recipes\data-migration\Ledger.cs" Link="Recipes\Ledger.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SdvKit.Shared\SdvKit.Shared.csproj" />
  </ItemGroup>
</Project>
